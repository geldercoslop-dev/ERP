import { ProductService } from '../services/product.service.js';

import { ServiceCreateResponse, ServiceList, ServicePaginated } from '../types/service-safety.js';
import { ValidationError } from '../_core/errors/typed-errors.js';



/**

 * CAMADA TOOLS: PRODUCT

 * Arquitetura: LEO → TOOLS → SERVICES → DATABASE

 * 

 * Responsabilidades:

 * - Orquestração entre LEO e SERVICES

 * - Validações leves e enriquecimento

 * - Logs e auditoria

 * - NÃO acessa DB direto

 */



type Payload = Record<string, unknown>;



export class ProductTool {

  constructor(private service: ProductService) {}



  /**

   * Criar novo produto com orquestração

   * @param input Dados do produto

   */

  async create(input: Payload) {

    console.log(`[ProductTool] Iniciando criação de produto:`, { timestamp: new Date().toISOString() });

    

    try {

      // Enriquecimento e validação leve

      const enrichedInput = this.enrichCreatePayload(input);

      

      // Log de auditoria

      console.log(`[ProductTool] Payload enriquecido:`, { 

        fields: Object.keys(enrichedInput),

        hasNome: 'nome' in enrichedInput,

        hasPreco: 'preco' in enrichedInput,

        hasEstoque: 'estoque' in enrichedInput

      });



      // Delegar para service

      const result = await this.service.create(enrichedInput);

      

      if (!result.success) {

        console.log(`[ProductTool] Erro na criação de produto:`, { 

          error: result.error,

          timestamp: new Date().toISOString() 

        });

        return result;

      }

      

      const data = result.if (!isServiceCreateResponse(data)) {
  throw new ValidationError("Invalid servicecreateresponse");
}
const validatedServiceCreateResponse = data; | undefined;

      console.log(`[ProductTool] Produto criado com sucesso:`, { 

        id: typeof data === 'object' && data !== null && 'id' in data ? (data as any).id : 'unknown',

        timestamp: new Date().toISOString() 

      });



      return result;

    } catch (error) {

      console.error(`[ProductTool] Erro na criação de produto:`, { 

        error: error instanceof Error ? error.message : String(error),

        timestamp: new Date().toISOString()

      });

      throw error;

    }

  }



  /**

   * Listar produtos com orquestração

   * @param input Filtros e paginação

   */

  async list(input: Payload) {

    console.log(`[ProductTool] Iniciando listagem de produtos:`, { timestamp: new Date().toISOString() });

    

    try {

      // Validação leve e normalização

      const normalizedInput = this.normalizeListPayload(input);

      

      // Log de auditoria

      console.log(`[ProductTool] Parâmetros de busca:`, {

        page: normalizedInput.page,

        limit: normalizedInput.limit,

        hasSearch: 'search' in normalizedInput,

        hasCategoria: 'categoria' in normalizedInput,

        hasPriceRange: 'minPreco' in normalizedInput || 'maxPreco' in normalizedInput

      });



      // Delegar para service

      const result = await this.service.list(normalizedInput);

      

      const data = result.if (!isServiceCreateResponse(data)) {
  throw new ValidationError("Invalid servicecreateresponse");
}
const validatedServiceCreateResponse = data; | undefined;

      console.log(`[ProductTool] Listagem concluída:`, { 

        count: typeof data === 'object' && data !== null && 'items' in data && Array.isArray((data as any).items) ? (data as any).items.length : 0,

        timestamp: new Date().toISOString() 

      });



      return result;

    } catch (error) {

      console.error(`[ProductTool] Erro na listagem de produtos:`, { 

        error: error instanceof Error ? error.message : String(error),

        timestamp: new Date().toISOString()

      });

      throw error;

    }

  }



  /**

   * Atualizar produto com orquestração

   * @param input Dados para atualização

   */

  async update(input: Payload) {

    console.log(`[ProductTool] Iniciando atualização de produto:`, { timestamp: new Date().toISOString() });

    

    try {

      // Validação de ID e enriquecimento

      const enrichedInput = this.enrichUpdatePayload(input);

      

      // Log de auditoria

      console.log(`[ProductTool] Atualização programada:`, {

        id: enrichedInput.id,

        fields: Object.keys(enrichedInput).filter(k => k !== 'id'),

        timestamp: new Date().toISOString()

      });



      // Delegar para service

      const result = await this.service.update(enrichedInput);

      

      const data = result.if (!isServiceCreateResponse(data)) {
  throw new ValidationError("Invalid servicecreateresponse");
}
const validatedServiceCreateResponse = data; | undefined;

      console.log(`[ProductTool] Produto atualizado com sucesso:`, { 

        id: typeof data === 'object' && data !== null && 'id' in data ? (data as any).id : 'unknown',

        timestamp: new Date().toISOString() 

      });



      return result;

    } catch (error) {

      console.error(`[ProductTool] Erro na atualização de produto:`, { 

        error: error instanceof Error ? error.message : String(error),

        timestamp: new Date().toISOString()

      });

      throw error;

    }

  }



  /**

   * Enriquecer payload de criação

   */

  private enrichCreatePayload(input: Payload): Payload {

    const enriched = { ...input };



    // Normalizar nome

    if ('nome' in enriched && typeof enriched.nome === 'string') {

      enriched.nome = enriched.nome.trim();

    }



    // Normalizar categoria se presente

    if ('categoria' in enriched && typeof enriched.categoria === 'string') {

      enriched.categoria = enriched.categoria.toLowerCase().trim();

    }



    // Adicionar timestamps

    enriched.createdAt = new Date().toISOString();

    enriched.updatedAt = new Date().toISOString();



    // Adicionar status padrão se não existir

    if (!('status' in enriched)) {

      enriched.status = 'ativo';

    }



    return enriched;

  }



  /**

   * Normalizar payload de listagem

   */

  private normalizeListPayload(input: Payload): Payload {

    const normalized = { ...input };



    // Garantir valores padrão

    if (!('page' in normalized) || typeof normalized.page !== 'number') {

      normalized.page = 1;

    }



    if (!('limit' in normalized) || typeof normalized.limit !== 'number') {

      normalized.limit = 50;

    }



    // Limitar máximo

    const limit = normalized.limit as number;

    if (limit > 100) {

      normalized.limit = 100;

    }



    // Normalizar categoria se presente

    if ('categoria' in normalized && typeof normalized.categoria === 'string') {

      normalized.categoria = normalized.categoria.toLowerCase().trim();

    }



    return normalized;

  }



  /**

   * Enriquecer payload de atualização

   */

  private enrichUpdatePayload(input: Payload): Payload {

    const enriched = { ...input };



    // Validar ID obrigatório

    if (!('id' in enriched) || typeof enriched.id !== 'number') {

      throw new ValidationError('ID é obrigatório para atualização');

    }



    // Normalizar nome se presente

    if ('nome' in enriched && typeof enriched.nome === 'string') {

      enriched.nome = enriched.nome.trim();

    }



    // Normalizar categoria se presente

    if ('categoria' in enriched && typeof enriched.categoria === 'string') {

      enriched.categoria = enriched.categoria.toLowerCase().trim();

    }



    // Adicionar timestamp de atualização

    enriched.updatedAt = new Date().toISOString();



    return enriched;

  }

}

