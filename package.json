{
  "name": "vendas-app",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "audit:check": "pnpm audit --audit-level=high",
    "dev": "cross-env NODE_ENV=development tsx watch --exclude dist --exclude node_modules --exclude server/_core/port.ts --exclude server/_core/**/*.log --exclude server/_core/**/*.tmp --import ./instrument.ts server/index.ts",
    "build:docker": "npm run build",
    "build:client": "vite build",
    "start": "node dist/server/index.js",
    "clean": "rimraf dist node_modules/.vite",
    "guard:arch": "node scripts/guard-arch.mjs",
    "validate:schema": "node scripts/validate-schema.mjs",
    "guard:esm": "node scripts/guard-esm-imports.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "build:clean": "pnpm run clean && pnpm run build",
    "check": "tsc --noEmit",
    "check:server": "tsc -p tsconfig.server.json --noEmit",
    "check:infra": "node server/scripts/check-infra.mjs",
    "infra:up": "docker compose -f docker-compose.infra.yml up -d",
    "infra:down": "docker compose -f docker-compose.infra.yml down --remove-orphans",
    "diag:infra": "node scripts/diag-infra.mjs",
    "validate:env": "node server/scripts/validate-env.mjs",
    "verify:system": "node scripts/verify-system.mjs",
    "verify:system:lite": "cross-env VERIFY_SKIP_DB=1 VERIFY_SKIP_REDIS=1 VERIFY_SKIP_HTTP=1 node scripts/verify-system.mjs",
    "validate:production": "node scripts/validate-production.mjs",
    "test:w1": "node server/scripts/W1-test-multitenant.mjs",
    "test:w2": "node server/scripts/W2-test-e2e.mjs",
    "test:w3": "node server/scripts/W3-test-leo.mjs",
    "test:w4": "node server/scripts/W4-test-load.mjs",
    "test:w5": "node server/scripts/W5-test-final.mjs",
    "test:windsurf": "node server/scripts/windsurf-full-test.mjs",
    "validate:final": "node FINAL-VALIDATION-REAL.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint server",
    "test": "vitest run",
    "test:schema": "vitest run server/tests/schema-consistency.test.ts",
    "db:push": "drizzle-kit push",
    "db:push:dev": "cross-env NODE_ENV=development drizzle-kit push",
    "db:push:prod": "node server/scripts/db-push-prod.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/scripts/run-migrate.ts",
    "db:validate": "tsx server/scripts/validate-idempotency-table.ts",
    "seed:admin": "tsx server/scripts/seed-admin.ts",
    "test:db": "tsx server/scripts/test-db-connection.ts",
    "check:db": "tsx server/scripts/check-database.ts",
    "test:core": "tsx server/tests/run-core-tests.ts",
    "test:consistency": "tsx server/tests/orchestrator-consistency.ts",
    "test:anti-regression": "tsx util/test/run-all.ts",
    "test:leo-gate": "tsx util/test/leo-test.ts",
    "test:load": "tsx util/test/load-test.ts",
    "test:db-stress": "tsx util/test/db-stress-test.ts",
    "test:hard-shutdown": "node server/scripts/hard-test-shutdown.mjs",
    "test:http-perf": "node scripts/http-perf/run-http-perf.mjs",
    "audit:perf-logs": "node scripts/http-perf/audit-logs.mjs",
    "fix:vendedor": "node server/scripts/fix-vendedor.js",
    "test:login": "tsx scripts/test-login.js",
    "pm2:start": "pm2 start deployment/ecosystem.config.js --env production --update-env",
    "pm2:restart": "pm2 restart erp-server --update-env",
    "pm2:logs": "pm2 logs erp-server --lines 200",
    "pm2:stop": "pm2 stop erp-server && pm2 delete erp-server",
    "diagnostic": "tsx server/tools/diagnostic-cli.ts",
    "staging:gate": "node ./scripts/staging-gate.mjs",
    "generate:env": "tsx scripts/generate-env.ts",
    "prepare": "if [ \"$NODE_ENV\" != \"production\" ]; then husky; fi"
  },
  "dependencies": {
