#!/bin/sh

echo "🔒 ARCHITECTURE CONTRACT GUARD"
node scripts/architecture-contract-guard.mjs
if [ $? -ne 0 ]; then
  exit 1
fi

echo "🔒 DRIZZLE SCHEMA GUARD - Validando integridade do schema e types"
node scripts/drizzle-schema-guard.mjs
if [ $? -ne 0 ]; then
  echo ""
  echo "🚨 PUSH BLOQUEADO"
  echo "drizzle-schema-guard falhou - schema ou types inválidos"
  exit 1
fi

echo "🔒 ROUTER DB WALL - Proteção contra DB direto em routers"
pnpm run guard:router-db-wall
if [ $? -ne 0 ]; then
  echo ""
  echo "🚨 PUSH BLOQUEADO"
  echo "router-db-wall falhou - DB direto detectado em router"
  exit 1
fi

pnpm run typecheck
