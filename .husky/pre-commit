#!/bin/sh

echo "🔒 MASSIVE DIFF PROTECTION"
CHANGED_FILES=$(git diff --cached --name-only | wc -l)
if [ $CHANGED_FILES -gt 10000 ]; then
  echo ""
  echo "⚠️  MASSIVE DIFF DETECTED: $CHANGED_FILES files staged"
  echo ""
  
  # Check if all files are .pnpm-store
  ALL_PNPM_STORE=$(git diff --cached --name-only | grep -v "^\.pnpm-store/" | wc -l)
  if [ $ALL_PNPM_STORE -eq 0 ]; then
    echo "✅ All files are .pnpm-store/ - cache cleanup detected"
    echo "Proceeding with architecture guards..."
  else
    echo "🚫 BLOCKED: Massive diff contains non-.pnpm-store files"
    echo ""
    echo "First 20 files:"
    git diff --cached --name-only | head -20
    echo ""
    echo "This may indicate accidental versioning of node_modules or other cache"
    echo "Please review and reset if this was unintentional:"
    echo "  git reset HEAD"
    exit 1
  fi
fi

echo "🔒 ARCHITECTURE CONTRACT GUARD"
node scripts/architecture-contract-guard.mjs
if [ $? -ne 0 ]; then
  exit 1
fi

echo "🔒 GUARDRAIL BOOTSTRAP"

node scripts/guardrail-check.js
if [ $? -ne 0 ]; then
  exit 1
fi

node scripts/anti-regress-check.js $(git diff --cached --name-only)
if [ $? -ne 0 ]; then
  exit 1
fi

echo "🔒 DRIZZLE SCHEMA GUARD - Validando integridade do schema e types"
node scripts/drizzle-schema-guard.mjs
if [ $? -ne 0 ]; then
  echo ""
  echo "🚨 COMMIT BLOQUEADO"
  echo "drizzle-schema-guard falhou - schema ou types inválidos"
  echo ""
  echo "Corrija as violações antes de commitar:"
  echo "  - Remova imports de tabelas inexistentes"
  echo "  - Use $inferSelect/$inferInsert para tipos de tabelas reais"
  echo "  - Não crie stubs (Record<string, unknown>) para tabelas que existem"
  exit 1
fi

echo "🔒 GATE OBRIGATÓRIO: verify:base (Context-Aware)"
echo "=============================================="
echo "Context: Local Development (fail-soft)"
echo "Production checks are disabled in local commits"
echo ""

pnpm run verify:base

if [ $? -ne 0 ]; then
  echo ""
  echo "🚨 COMMIT BLOQUEADO"
  echo "verify:base falhou - corrija os erros antes de commitar"
  echo ""
  echo "NOTA: Em desenvolvimento local, Redis é opcional."
  echo "Se o erro for relacionado a Redis, você pode:"
  echo "  1. Iniciar Redis: docker compose -f docker-compose.infra.yml up -d redis"
  echo "  2. Ou configurar CI_REDIS_REQUIRED=false no .env"
  exit 1
fi

echo ""
echo "✅ Commit liberado"
