{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "rootDir": "server",
    "outDir": "dist/server",
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo.explicit",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "sourceRoot": "../"
  },
  "files": [
    "server/index.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist/**/*"
  ]
}
