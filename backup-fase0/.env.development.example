# Copie para .env.development e preencha (uso em NODE_ENV=development)
# Opção recomendada: gerar secrets fortes automaticamente
#   pnpm run generate:env
# (cria/atualiza .env.development com JWT_*, APP_SECRET, SESSION_SECRET, Redis, DATABASE_URL local)

NODE_ENV=development
PORT=3000

# Banco: use DATABASE_URL ou as variáveis separadas
# DATABASE_URL=mysql://vendas:vendas123@localhost:3306/vendas_app
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=vendas
# DB_PASSWORD=vendas123
# DB_NAME=vendas_app

# Cliente (Vite): URL do tRPC (preferir relativo para cookie na mesma origem)
# VITE_TRPC_URL=/api/trpc

# Sentry (opcional)
# SENTRY_DSN=
# VITE_SENTRY_DSN=
