# Copie para .env.production e preencha (uso em NODE_ENV=production)
# cp .env.production.example .env.production

NODE_ENV=production
PORT=3000

# Banco (obrigatório em produção)
# IMPORTANTE: no Docker Compose deste repo o host é o serviço vendas-mysql (não "mysql" nem localhost na rede compose).
# DATABASE_URL=mysql://usuario:senha@vendas-mysql:3306/erp
# Ou: DB_HOST=vendas-mysql, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME

# Cliente: URL do tRPC (ex.: https://seu-dominio.com/api/trpc)
# VITE_TRPC_URL=/api/trpc

# Sentry (recomendado em produção)
# SENTRY_DSN=
# VITE_SENTRY_DSN=
