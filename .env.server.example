# Server Environment Variables Example
# Copy this file to .env and fill in the actual values

# Database (REQUIRED - no fallback)
DATABASE_URL=mysql://user:password@localhost:3306/database_name

# Redis (REQUIRED - no fallback)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Server Configuration
NODE_ENV=development
PORT=3001

# JWT Secrets (REQUIRED - generate secure random strings)
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here
APP_SECRET=your_app_secret_here

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Docker MySQL Variables (ONLY for docker-compose - NOT used by application)
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=database_name
MYSQL_USER=mysql_user
MYSQL_PASSWORD=mysql_password
