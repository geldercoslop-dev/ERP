export const cargas = mysqlTable(
  "cargas",
  {
    id: int("id").primaryKey().autoincrement(),
    numero: text("numero").notNull(),
    cidadeRota: varchar("cidadeRota", { length: 100 }),
    dataEntrega: varchar("dataEntrega", { length: 10 }),
    status: mysqlEnum("status", ['ABERTA', 'EM_ROTA', 'ENTREGUE']).default('ABERTA').notNull(),
    createdAt: timestamp("createdAt", { mode: 'string' }).default('now()').notNull(),
    updatedAt: timestamp("updatedAt", { mode: 'string' }).default('now()').notNull(),
  },
  (table) => ({
    cargasNumeroUnique: unique("cargas_numero_unique").on(table.numero),
    numeroIdx: index("numero_idx").on(table.numero),
    statusIdx: index("status_idx").on(table.status),
  }),
);

export const clientes = mysqlTable(
  "clientes",
  {
    id: int("id").primaryKey().autoincrement(),
    nome: varchar("nome", { length: 255 }).notNull(),
    telefone: varchar("telefone", { length: 20 }),
    telefoneRecado: varchar("telefoneRecado", { length: 20 }),
    rua: text("rua"),
    numero: varchar("numero", { length: 20 }),
    bairro: varchar("bairro", { length: 100 }),
    cidade: varchar("cidade", { length: 100 }),
    uf: varchar("uf", { length: 2 }),
    referencia: text("referencia"),
    condominio: text("condominio"),
    createdAt: timestamp("createdAt", { mode: 'string' }).default('now()').notNull(),
    updatedAt: timestamp("updatedAt", { mode: 'string' }).default('now()').notNull(),
  },
  (table) => ({
    nomeIdx: index("nome_idx").on(table.nome),
    telefoneIdx: index("telefone_idx").on(table.telefone),
  }),
);

export const comissoes = mysqlTable(
  "comissoes",
  {
    id: int("id").primaryKey().autoincrement(),
    vendedorId: text("vendedorId").notNull().references(() => vendedores.id),
    pedidoId: text("pedidoId").notNull().references(() => pedidos.id),
    cargaId: text("cargaId").references(() => cargas.id),
    valorVenda: decimal("valorVenda", { precision: 10, scale: 2 }).default('0.00').notNull(),
    percentualComissao: decimal("percentualComissao", { precision: 5, scale: 2 }).default('0.00').notNull(),
    valorComissao: decimal("valorComissao", { precision: 10, scale: 2 }).default('0.00').notNull(),
    status: mysqlEnum("status", ['PENDENTE', 'PAGA']).default('PENDENTE').notNull(),
    dataPagamento: timestamp("dataPagamento", { mode: 'string' }),
    createdAt: timestamp("createdAt", { mode: 'string' }).default('now()').notNull(),
    updatedAt: timestamp("updatedAt", { mode: 'string' }).default('now()').notNull(),
  },
  (table) => ({
    comissoesCargaIdCargasIdFk: index("comissoes_cargaId_cargas_id_fk").on(table.cargaId),
    pedidoIdx: index("pedido_idx").on(table.pedidoId),
    statusIdx: index("status_idx").on(table.status),
    vendedorIdx: index("vendedor_idx").on(table.vendedorId),
  }),
);

export const contasFixas = mysqlTable(
  "contas_fixas",
  {
    id: int("id").primaryKey().autoincrement(),
    nome: varchar("nome", { length: 255 }).notNull(),
    categoria: varchar("categoria", { length: 100 }),
    fornecedorId: text("fornecedorId").references(() => fornecedores.id),
    valor: decimal("valor", { precision: 10, scale: 2 }).default('0.00').notNull(),
    diaVencimento: text("diaVencimento").notNull(),
    ativo: text("ativo").default('1').notNull(),
    createdAt: timestamp("createdAt", { mode: 'string' }).default('now()').notNull(),
    updatedAt: timestamp("updatedAt", { mode: 'string' }).default('now()').notNull(),
    planoContasId: text("planoContasId").references(() => planoContas.id),
  },
  (table) => ({
    contasFixasFornecedorIdFornecedoresIdFk: index("contas_fixas_fornecedorId_fornecedores_id_fk").on(table.fornecedorId),
    contasFixasPlanoContasIdPlanoContasIdFk: index("contas_fixas_planoContasId_plano_contas_id_fk").on(table.planoContasId),
  }),
);

export const contasPagar = mysqlTable(
  "contas_pagar",
  {
    id: int("id").primaryKey().autoincrement(),
    contaFixaId: text("contaFixaId").references(() => contasFixas.id),
    fornecedorId: text("fornecedorId").references(() => fornecedores.id),
    descricao: varchar("descricao", { length: 255 }).notNull(),
    categoria: varchar("categoria", { length: 100 }),
    valor: decimal("valor", { precision: 10, scale: 2 }).default('0.00').notNull(),
    dataVencimento: varchar("dataVencimento", { length: 10 }).notNull(),
    dataPagamento: varchar("dataPagamento", { length: 10 }),
    status: mysqlEnum("status", ['PENDENTE', 'PAGA', 'VENCIDA']).default('PENDENTE').notNull(),
    observacoes: text("observacoes"),
    createdAt: timestamp("createdAt", { mode: 'string' }).default('now()').notNull(),
    updatedAt: timestamp("updatedAt", { mode: 'string' }).default('now()').notNull(),
    planoContasId: text("planoContasId").references(() => planoContas.id),
  },
  (table) => ({
    contasPagarContaFixaIdContasFixasIdFk: index("contas_pagar_contaFixaId_contas_fixas_id_fk").on(table.contaFixaId),
    contasPagarFornecedorIdFornecedoresIdFk: index("contas_pagar_fornecedorId_fornecedores_id_fk").on(table.fornecedorId),
    contasPagarPlanoContasIdPlanoContasIdFk: index("contas_pagar_planoContasId_plano_contas_id_fk").on(table.planoContasId),
    statusIdx: index("status_idx").on(table.status),
    vencimentoIdx: index("vencimento_idx").on(table.dataVencimento),
  }),
);

