{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "lib": ["ES2022"],
    "types": ["node", "jsonwebtoken"]
  },
  "include": ["server/**/*", "shared/**/*", "drizzle/**/*", "scripts/test-auth.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "**/*.test.ts",
    "**/*.spec.ts",
    "server/tests/**",
    "server/security/attack-testing.ts",
    "server/security/penetration-test.ts",
    "server/types/service-safe-example.ts",
    "shared/**/*.d.ts",
    "drizzle/schema.d.ts"
  ]
}
