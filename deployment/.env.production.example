# Modelo para produção. Copie para a raiz como .env.production e preencha.
# cp deployment/.env.production.example .env.production

NODE_ENV=production
PORT=3000

# Obrigatório — host = nome do serviço MySQL no docker-compose.prod.yml (vendas-mysql)
DATABASE_URL=mysql://usuario:senha@vendas-mysql:3306/nome_do_banco
JWT_SECRET=defina_um_secret_longo_e_aleatorio

# Opcional
# ADMIN_INITIAL_PASSWORD=...
# ALLOWED_ORIGINS=https://erp.seudominio.com
# VITE_TRPC_URL=/api/trpc
