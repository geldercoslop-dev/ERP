# Copie para .env. O backend carrega apenas .env na raiz (sem cadeia .env.* com override).
# No Docker, use env_file: .env no compose; valores já no processo não são sobrescritos.
# cp .env.example .env
# Produção: use NODE_ENV=production e PORT=3000 (servidor escuta nessa porta).

NODE_ENV=production
PORT=3000

# --- Banco (obrigatório) ---
# IMPORTANTE:
# O host SEMPRE deve ser o nome do serviço docker (vendas-mysql)
# NÃO usar localhost nem mysql
#
# Padrão (compose deste repositório):
DATABASE_URL=mysql://usuario:senha@vendas-mysql:3306/erp

# Para o contentor MySQL criar o mesmo utilizador da DATABASE_URL (env_file no compose):
# MYSQL_ROOT_PASSWORD=...
# MYSQL_DATABASE=erp
# MYSQL_USER=usuario
# MYSQL_PASSWORD=senha

# --- Redis (obrigatório) ---
# O schema exige REDIS_URL (usado em parts do sistema) e o boot valida REDIS_HOST/REDIS_PORT.
# Use ambos para compatibilidade total.
REDIS_URL=redis://vendas-redis:6379
REDIS_HOST=vendas-redis
REDIS_PORT=6379

# --- Segredos (obrigatório) ---
# Em produção (NODE_ENV=production): mínimo 64 caracteres.
# Gere com: openssl rand -base64 48 | tr -d '\n' | head -c 64
JWT_ACCESS_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
APP_SECRET=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc

# --- Sessão (recomendado) ---
SESSION_SECRET=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd

# --- Cliente (Vite) ---
# Preferir /api/trpc para mesma origem (cookie de sessão)
# VITE_TRPC_URL=/api/trpc

# --- Sentry (opcional) ---
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_AUTH_TOKEN=...
# SENTRY_ORG=...
# SENTRY_PROJECT=...
# SENTRY_RELEASE=vendas-app@1.0.0
