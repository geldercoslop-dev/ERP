# ERP - .env.example
# Copie este arquivo para .env e preencha os valores reais.
# NÃO COLOQUE SENHAS REAIS NESTE ARQUIVO!

# --- Ambiente ---
NODE_ENV=production
PORT=3000

# --- Banco de Dados (MySQL) ---
# DATABASE_URL=mysql://<user>:<password>@vendas-mysql:3306/<database>
DATABASE_URL=mysql://vendas:senha_segura_aqui@vendas-mysql:3306/erp

# Variáveis para o container MySQL
MYSQL_ROOT_PASSWORD=mudar_senha_root
MYSQL_DATABASE=erp
MYSQL_USER=vendas
MYSQL_PASSWORD=senha_segura_aqui

# --- Cache & Queues (Redis) ---
REDIS_URL=redis://vendas-redis:6379
REDIS_HOST=vendas-redis
REDIS_PORT=6379

# --- Segurança & JWT (Mínimo 64 caracteres para produção) ---
# Gere chaves seguras com: openssl rand -base64 48
JWT_ACCESS_SECRET=insira_uma_chave_aleatoria_de_64_caracteres_aqui_acesso
JWT_REFRESH_SECRET=insira_uma_chave_aleatoria_de_64_caracteres_aqui_refresh
APP_SECRET=insira_uma_chave_aleatoria_de_64_caracteres_aqui_app
SESSION_SECRET=insira_uma_chave_aleatoria_de_64_caracteres_aqui_sessao

# --- Configurações Adicionais ---
ALLOWED_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@vendas.local
ADMIN_PASSWORD=senha_admin_segura
