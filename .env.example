# Copie para .env e preencha. O app carrega também .env.development ou .env.production conforme NODE_ENV.
# cp .env.example .env

NODE_ENV=development
PORT=3003

# --- Banco (obrigatório) ---
# Use DATABASE_URL OU as variáveis separadas:
# DATABASE_URL=mysql://user:password@host:3306/database
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=vendas
# DB_PASSWORD=vendas123
# DB_NAME=vendas_app

# --- Cliente (Vite) ---
# Preferir /api/trpc para mesma origem (cookie de sessão)
# VITE_TRPC_URL=/api/trpc

# --- Sentry (opcional) ---
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_AUTH_TOKEN=...
# SENTRY_ORG=...
# SENTRY_PROJECT=...
# SENTRY_RELEASE=vendas-app@1.0.0
