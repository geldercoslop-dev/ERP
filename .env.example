NODE_ENV=development
PORT=3000

# Database (required)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=erp
DATABASE_URL=mysql://root:root@localhost:3306/erp

# Redis (required)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT and app secrets (required)
JWT_SECRET=replace_with_secure_secret_minimum_32_chars_first
JWT_ACCESS_SECRET=replace_with_secure_secret_minimum_32_chars_second
JWT_REFRESH_SECRET=replace_with_secure_secret_minimum_32_chars_third
APP_SECRET=replace_with_secure_secret_minimum_32_chars_fourth
SESSION_SECRET=replace_with_secure_secret_minimum_32_chars_fifth

# Optional
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
